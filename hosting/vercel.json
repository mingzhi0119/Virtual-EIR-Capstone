{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "node ../scripts/build-eir-vercel.mjs",
  "git": {"deploymentEnabled": {"main": true, "*": false}},
  "regions": ["iad1"],
  "functions": {"main.py": {"maxDuration": 180, "includeFiles": "eir/**"}},
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
    ]
  }]
}
